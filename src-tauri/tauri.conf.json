{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PerfPilot",
  "version": "0.1.2",
  "identifier": "dev.perfpilot.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PerfPilot",
        "width": 1320,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "AI-Native Performance Testing Platform",
    "longDescription": "PerfPilot is an AI-native desktop performance testing platform built on Tauri 2, Vue 3, and k6.",
    "externalBin": [
      "binaries/k6"
    ]
  },
  "plugins": {}
}